{
  "name": "stock-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:hl-identity": "node --experimental-strip-types --test src/components/hyperliquid/identity.test.ts",
    "test:hl-format": "node --experimental-strip-types --test src/components/hyperliquid/format.test.ts",
    "test:hl-queries": "esbuild src/components/hyperliquid/queries.test.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=/tmp/hl-queries.test.mjs && node --test /tmp/hl-queries.test.mjs",
    "test:hl-pages": "esbuild src/pages/hyperliquid-pages.test.tsx --bundle --platform=node --format=cjs --alias:@=./src --outfile=/tmp/hl-pages.test.cjs && node --test /tmp/hl-pages.test.cjs",
    "test:hl": "npm run test:hl-identity && npm run test:hl-format && npm run test:hl-queries && npm run test:hl-pages",
    "test:news-page": "esbuild src/pages/news-page.test.tsx --bundle --platform=node --format=cjs --alias:@=./src --outfile=/tmp/news-page.test.cjs && node --test /tmp/news-page.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^5.5.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.5"
  }
}
